<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="tracker_v2.db"/>
        <include domain="sharedpref" path="tracker_preferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tracker_v2.db"/>
        <include domain="sharedpref" path="tracker_preferences.xml"/>
    </device-transfer>
</data-extraction-rules>